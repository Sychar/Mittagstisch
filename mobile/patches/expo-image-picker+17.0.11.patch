+  private func handleImageFromPhotoLibraryAsset(
+    _ selectedImage: PHPickerResult
+  ) async -> (assetInfo: AssetInfo?, diagnostics: [String]) {
+    let authorization = photoLibraryAuthorizationDescription()
+    guard let assetId = selectedImage.assetIdentifier else {
+      return (nil, ["PHASSET_ASSET_ID_MISSING(auth=\(authorization))"])
+    }
+
+    let fetchResult = PHAsset.fetchAssets(withLocalIdentifiers: [assetId], options: nil)
+    guard let asset = fetchResult.firstObject else {
+      return (nil, ["PHASSET_FETCH_EMPTY(auth=\(authorization))"])
+    }
+
+    let resources = PHAssetResource.assetResources(for: asset)
+    let preferredTypes: [PHAssetResourceType] = [
+      .fullSizePhoto,
+      .photo,
+      .adjustmentBasePhoto,
+      .alternatePhoto
+    ]
+    let orderedResources = preferredTypes.flatMap { preferredType in
+      resources.filter { $0.type == preferredType }
+    }
+    guard !orderedResources.isEmpty else {
+      let availableTypes = resources.map { String($0.type.rawValue) }.joined(separator: ",")
+      return (nil, ["PHASSET_NO_PHOTO_RESOURCE(types=\(availableTypes),auth=\(authorization))"])
+    }
+
+    let requestOptions = PHAssetResourceRequestOptions()
+    requestOptions.isNetworkAccessAllowed = true
+    var diagnostics: [String] = []
+
+    for resource in orderedResources {
+      let originalFilename = resource.originalFilename
+      let filenameExtension = getFileExtension(from: originalFilename)
+      let contentTypeExtension = UTType(resource.uniformTypeIdentifier)?.preferredFilenameExtension.map { ".\($0)" }
+      guard let fileExtension = filenameExtension != "." ? filenameExtension : contentTypeExtension else {
+        diagnostics.append("PHASSET_EXTENSION_MISSING(type=\(resource.type.rawValue))")
+        continue
+      }
+
+      do {
+        let targetUrl = try generateUrl(withFileExtension: fileExtension)
+        try await PHAssetResourceManager.default().writeData(
+          for: resource,
+          toFile: targetUrl,
+          options: requestOptions
+        )
+
+        let size = ImageUtils.readVisualSizeFrom(url: targetUrl) ?? .zero
+        let fileSize = getFileSize(from: targetUrl)
+        let mimeType = getMimeType(from: targetUrl.pathExtension)
+        var rawData: Data?
+        if options.base64 || options.exif {
+          rawData = try? Data(contentsOf: targetUrl)
+        }
+
+        return (
+          AssetInfo(
+            assetId: assetId,
+            uri: targetUrl.absoluteString,
+            width: Double(size.width),
+            height: Double(size.height),
+            fileName: originalFilename,
+            fileSize: fileSize,
+            mimeType: mimeType,
+            base64: options.base64 ? rawData?.base64EncodedString() : nil,
+            exif: options.exif ? rawData.flatMap { ImageUtils.readExifFrom(data: $0) } : nil
+          ),
+          diagnostics
+        )
+      } catch {
+        diagnostics.append(
+          describeImageReadError(stage: "PHASSET_RESOURCE_\(resource.type.rawValue)", error: error)
+        )
+      }
+    }
+
+    return (nil, diagnostics)
+  }
+
+  private func photoLibraryAuthorizationDescription() -> String {
+    switch PHPhotoLibrary.authorizationStatus(for: .readWrite) {
+    case .authorized:
+      return "authorized"
+    case .limited:
+      return "limited"
+    case .denied:
+      return "denied"
+    case .restricted:
+      return "restricted"
+    case .notDetermined:
+      return "notDetermined"
+    @unknown default:
+      return "unknown"
+    }
+  }
+
+  private func describeImageReadError(stage: String, error: Error) -> String {
+    let nativeError = error as NSError
+    let message = nativeError.localizedDescription.replacingOccurrences(of: "|", with: "/")
+    return "\(stage)(domain=\(nativeError.domain),code=\(nativeError.code),message=\(message))"
+  }
+
